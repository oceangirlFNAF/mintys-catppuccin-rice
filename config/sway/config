### Variables
#
# Logo key. Use Mod1 for Alt.
set $mod Mod4
# Your preferred terminal emulator
set $term kitty
# Your preferred application launcher
set $menu pgrep wofi >/dev/null 2>&1 && killall wofi || wofi --show drun --location=center
# Your preferred browser
set $browser waterfox
# Your preferred file explorer
set $file_explorer nemo

### Output configuration
#
# Default wallpaper (note to self: add more stuff too wallpaper, looks too bland rn)
output * bg $HOME/Desktop/Pictures/bg.jpg fill
#
output HDMI-A-1 resolution 1920x1080@143.997hz position 0,0
#
# You can get the names of your outputs by running: swaymsg -t get_outputs
#
exec dbus-update-activation-environment DISPLAY
### Visuals
#
# Adds margins
#
gaps inner 8px
gaps outer 4px
#
# In order, the hex codes are for border, background, text, indicator, and child border
#
client.focused          #b4befe #313244 #cdd6f4 #b4befe #b4befe
client.focused_inactive #6c7086 #313244 #cdd6f4 #6c7086 #6c7086
client.unfocused        #6c7086 #313244 #cdd6f4 #6c7086 #6c7086
client.urgent           #f38ba8 #313244 #cdd6f4 #f38ba8 #f38ba8
client.placeholder      #b4befe #313244 #cdd6f4 #b4befe #b4befe

### Input configuration
#
# I use colemak, switch it to whatever keyboard layout you use
#
   input type:keyboard {
       xkb_layout "us"
       xkb_variant "colemak"
   }
#
# Disable mouse acceleration and change sensitivity
#
input type:pointer {
    accel_profile "flat" 
    pointer_accel 0.62 
}
# You can also configure each device individually.
# Read `man 5 sway-input` for more information about this section.

### Key bindings
#
# Basics:
#
    # Start a terminal
    bindsym $mod+Return exec $term
    # Kill focused window
    bindsym $mod+q kill
    # Start your launcher
    bindsym $mod+s exec $menu
    # Start a file explorer
    bindsym $mod+f exec $file_explorer
    # Start a browser
    bindsym $mod+w exec $browser

    # Drag floating windows by holding down $mod and left mouse button.
    # Resize them with right mouse button + $mod.
    # Despite the name, also works for non-floating windows.
    # Change normal to inverse to use left mouse button for resizing and right
    # mouse button for dragging.
    floating_modifier $mod normal

    # Reload the configuration file
    bindsym $mod+Shift+c reload

    # Exit sway (logs you out of your Wayland session)
    bindsym $mod+Shift+f exec swaynag -t warning -m 'Exit sway? Ends Wayland session.' -B 'Yes' 'swaymsg exit'
#
# Workspaces:
#
    # Switch to workspace
    bindsym $mod+1 workspace number 1
    bindsym $mod+2 workspace number 2
    bindsym $mod+3 workspace number 3
    bindsym $mod+4 workspace number 4
    bindsym $mod+5 workspace number 5
    bindsym $mod+6 workspace number 6
    bindsym $mod+7 workspace number 7
    bindsym $mod+8 workspace number 8
    bindsym $mod+9 workspace number 9
    bindsym $mod+0 workspace number 10
    # Move focused container to workspace
    bindsym $mod+Shift+1 move container to workspace number 1
    bindsym $mod+Shift+2 move container to workspace number 2
    bindsym $mod+Shift+3 move container to workspace number 3
    bindsym $mod+Shift+4 move container to workspace number 4
    bindsym $mod+Shift+5 move container to workspace number 5
    bindsym $mod+Shift+6 move container to workspace number 6
    bindsym $mod+Shift+7 move container to workspace number 7
    bindsym $mod+Shift+8 move container to workspace number 8
    bindsym $mod+Shift+9 move container to workspace number 9
    bindsym $mod+Shift+0 move container to workspace number 10
    # Note: workspaces can have any name you want, not just numbers.
    # I just use 1-10 as the default.
#
# Layout stuff:
#
    # Make the current focus fullscreen
    bindsym $mod+t fullscreen

    # Toggle the current focus between tiling and floating mode
    bindsym $mod+space floating toggle

    # Swap focus between the tiling area and the floating area
    bindsym $mod+Shift+space focus mode_toggle
#
# Utilities:
#
    # Special key to take a screenshot with sway-screenshot
    bindsym Print exec sway-screenshot -o $HOME/Desktop/Pictures -m region

#
# Status Bar:
#
bar {
    swaybar_command waybar
}


include /etc/sway/config.d/*
